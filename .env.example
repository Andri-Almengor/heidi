NODE_ENV=development
PORT=3000

# Deployed Google Apps Script /exec URL
APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE/exec

# Private key returned by setupProject(). Never expose it to the frontend.
APPS_SCRIPT_API_KEY=REPLACE

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
APPS_SCRIPT_TIMEOUT_MS=25000

# Apps Script allows 30 simultaneous executions per user. Keep headroom for
# setup/admin tasks and Google-side variance.
APPS_SCRIPT_MAX_CONCURRENCY=20

TRUST_PROXY=0
SERVE_FRONTEND=0
